VITE_API_URL=http://localhost:8000

# ===== Power BI =====
# You have ONE report with three pages. Use the BASE_URL + per-page-name pattern.
#
# 1) In Power BI Service open the report.
#    File -> Embed report -> Publish to web (public) -> Create embed code -> Publish
#    Copy the LINK (not the iframe HTML). It looks like:
#      https://app.powerbi.com/view?r=eyJrIjoi...
VITE_PBI_BASE_URL=
#
# 2) Page section names. The 22-char IDs in your authenticated report URL
#    work as pageName values, e.g.:
#      .../reports/<report-id>/9624f37881810d377aac?experience=power-bi
#                              ^^^^^^^^^^^^^^^^^^^^^^ this is the page name
VITE_PBI_EXECUTIVE_PAGE=9624f37881810d377aac
VITE_PBI_OPERATIONS_PAGE=1df350ca1db57a50520a
VITE_PBI_ANALYTICS_PAGE=49829578d1e2a3825c00

# --- Optional override: full per-category URL (takes precedence over BASE+PAGE) ---
# If you've published THREE separate reports (one per dashboard), use these instead.
VITE_PBI_EXECUTIVE_URL=
VITE_PBI_OPERATIONS_URL=
VITE_PBI_ANALYTICS_URL=
